{
    "manifest_version": 3,
    "name": "TabTidy - Tab Manager",
    "version": "1.0",
    "description": "Organize your browser tabs efficiently",
    "permissions": ["tabs", "storage", "contextMenus", "notifications"],
    "host_permissions": ["<all_urls>"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "src/popup/popup.html",
      "default_icon": {
        "16": "icons/icon16.png",
        "48": "icons/icon32.png",
        "128": "icons/icon128.png"
      }
    },
    "icons": {
      "48": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  }
  